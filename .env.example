# Optional. When unset, Swatch normalizes tokens with the deterministic local clusterer.
OPENAI_API_KEY=

# Optional. Overrides the model used for structured token synthesis.
SWATCH_OPENAI_MODEL=gpt-5.4-mini

# Optional. Absolute origin used for share link preview images, for example https://swatch.example.com.
# Defaults to the Vercel production URL when deployed there, or http://localhost:3000.
SWATCH_PUBLIC_URL=

# Optional. "bundled" uses Playwright's Chromium, "serverless" uses @sparticuz/chromium.
# Detected automatically from VERCEL and AWS_LAMBDA_FUNCTION_NAME when unset.
SWATCH_CHROMIUM=
